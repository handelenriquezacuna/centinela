# Molde de .env (H-25). NO se llena a mano: `python tareas.py arriba` crea .env la
# primera vez con contrasenas aleatorias (secrets.token_urlsafe). .env no se versiona.
#
# Contrasenas de los usuarios de base de datos (scripts/semilla/04-usuarios.js).
MONGO_CLAVE_APP=
MONGO_CLAVE_ANALISTA=
MONGO_CLAVE_ADMIN=
MONGO_CLAVE_PRUEBAS=
# Clave de firma de la sesion de la app (T-41), minimo 32 caracteres.
CENTINELA_SESION__CLAVE=
