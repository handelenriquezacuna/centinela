# Molde de las variables de entorno de Centinela. Copiar a infra/.env y rellenar.
#
# AQUI VAN SOLO SECRETOS. Todo lo que no es secreto va en config/centinela.yml, que
# si se versiona. Y al contrario: ningun secreto va en el YAML.
#
# infra/.env esta en .gitignore. Este archivo de ejemplo SI se versiona, con valores
# de mentira, para que se sepa que variables existen sin filtrar ninguna.
#
# Cualquier variable de entorno le gana a los dos YAML. El prefijo es CENTINELA_ y el
# separador de nivel es doble guion bajo. Ver docs/06-plataforma.md, seccion 3.

# --- Conexion a MongoDB ---
# Hoy el replica set de desarrollo no tiene autenticacion, asi que la URI del YAML
# alcanza y esta variable no hace falta. Cuando H-25 active usuarios con roles, la
# URI con credenciales va AQUI y no en el YAML.
# CENTINELA_MONGO__URI=mongodb://usuario:contrasena@localhost:27018,localhost:27019,localhost:27020/?replicaSet=rsfraude&authSource=admin

# Util para apuntar a otra base sin tocar archivos, por ejemplo al correr pruebas.
# CENTINELA_MONGO__BASE=antifraude_pruebas

# --- Correo del disparador D2 (H-11) ---
# El envio es contra un SMTP de pruebas; la contrasena, cuando exista, va aqui.
# CENTINELA_CORREO__USUARIO=centinela
# CENTINELA_CORREO__CONTRASENA=cambiar

# --- Firma de tokens (H-25) ---
# CENTINELA_AUTENTICACION__LLAVE_SECRETA=generar-una-llave-larga-y-aleatoria
